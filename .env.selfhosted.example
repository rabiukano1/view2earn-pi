# Self-hosted Convex on the VPS (production).
# Copy to .env.selfhosted and fill in. Never commit .env.selfhosted.
#
# The admin key is printed once by generate_admin_key.sh on the server
# (infra/vps). Treat it like a root password.
CONVEX_SELF_HOSTED_URL=https://api.view2earn.org
CONVEX_SELF_HOSTED_ADMIN_KEY=paste-admin-key-here
# Read by app configs / auth.config.ts as the public HTTP-actions origin.
CONVEX_URL=https://api.view2earn.org
CONVEX_SITE_URL=https://site.view2earn.org
