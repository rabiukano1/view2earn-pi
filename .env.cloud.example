# Convex Cloud (the original managed deployment).
# Kept only as a rollback target — it is disabled while the free-plan limit is exceeded.
# Copy to .env.cloud and fill in. Never commit .env.cloud.
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment-name.convex.cloud
CONVEX_SITE_URL=https://your-deployment-name.convex.site
