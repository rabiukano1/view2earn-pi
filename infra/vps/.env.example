# Copy to /opt/convex/.env on the server and fill in. Root-readable only:
#   chmod 600 /opt/convex/.env
#
# INSTANCE_SECRET must be set BEFORE generating the admin key — changing it
# later invalidates every admin key and breaks the deployment.
#   openssl rand -hex 32

CONVEX_CLOUD_ORIGIN=https://api.view2earn.org
CONVEX_SITE_ORIGIN=https://site.view2earn.org

INSTANCE_NAME=view2earn
INSTANCE_SECRET=

# --- Storage ---------------------------------------------------------------
# Leave POSTGRES_URL empty to use the built-in SQLite database (recommended
# here: the whole dataset is ~6 MB / 123k documents).
# For Postgres instead:
#   POSTGRES_URL=postgres://user:password@host:5432
#   DO_NOT_REQUIRE_SSL=true     # only if the DB is on this same host
POSTGRES_URL=
DO_NOT_REQUIRE_SSL=

# --- Hardening / tuning ----------------------------------------------------
DISABLE_BEACON=true
REDACT_LOGS_TO_CLIENT=true
V8_ACTION_USER_TIMEOUT_SECS=60
NODE_ACTION_USER_TIMEOUT_SECS=120
DOCUMENT_RETENTION_DELAY=172800
RUST_LOG=info

# Sized for 1 vCPU / 3.3 GB. Node actions are the expensive ones (each runs a
# Node process: convex/anchor.ts and convex/piWithdrawalsPayout.ts).
# Raise these if you add CPU.
APPLICATION_MAX_CONCURRENT_MUTATIONS=8
APPLICATION_MAX_CONCURRENT_QUERIES=8
APPLICATION_MAX_CONCURRENT_V8_ACTIONS=4
APPLICATION_MAX_CONCURRENT_NODE_ACTIONS=2
