# Local development backend on this laptop.
# Copy to .env.localdev. Safe to wipe and re-import at any time.
#
# Option A (default, matches infra/laptop/docker-compose.yml):
#   docker compose -f infra/laptop/docker-compose.yml up -d
#   then generate the admin key once (see infra/README.md).
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=paste-local-admin-key-here
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211
#
# Option B (no Docker): the Convex CLI's own local deployment, already set up
# in this repo. Comment out the four lines above and use this single line:
# CONVEX_DEPLOYMENT=local:local-muhammad_musa_c99d2-view2earn
#
# Both bind port 3210 — run only one at a time.

# The local database holds a full production import (123k+ documents), which
# takes longer than the CLI's 30s default to open. Without this, `convex dev`
# fails with "Local backend did not start on port 3210 within 30 seconds".
CONVEX_LOCAL_BACKEND_STARTUP_TIMEOUT_SECS=180
